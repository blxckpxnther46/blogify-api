# MongoDB Connection String
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/blogify-db?retryWrites=true&w=majority

# Server Configuration
# Port for the Express server (default: 3000)
PORT=3000

# Environment
# Set to 'production' for deployed application
# Set to 'development' for local development
NODE_ENV=development

# Note: 
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual configuration
# 3. NEVER commit .env file to version control
# 4. Keep sensitive credentials secure
